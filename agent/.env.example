# hotel-agent configuration. Copy to .env for local runs.
# Never commit a filled-in copy. In Agent Manager every value below is set as
# an environment variable or secret on the deployment, not in the repository.

# --- Model ------------------------------------------------------------------
OPENAI_MODEL=gpt-4o

# One key, both modes. OPENAI_URL presence is the only mode gate:
#   OPENAI_URL empty -> the key goes straight to OpenAI
#   OPENAI_URL set   -> the key goes to the AM gateway on an API-Key header,
#                       and org-level guardrails apply
OPENAI_API_KEY=
OPENAI_URL=

# --- hotel-mcp endpoint -----------------------------------------------------
# Injected by Agent Manager when the hotel-mcp proxy is attached to this agent.
# Set by hand only for local runs against a directly reachable server.
HOTEL_MCP_URL=http://localhost:9000/mcp

# --- hotel-mcp credential (egress) ------------------------------------------
# Supply ONE shape, or none if the endpoint is unsecured. auth.py prefers
# OAuth2 over an API key so a stale key cannot silently downgrade a migrated
# agent. hotel-mcp itself enforces nothing; the gateway in front of it does.

# Shape 1: API key.
HOTEL_MCP_API_KEY=
# AM's docs disagree between API-Key and X-API-Key, so this is configurable.
HOTEL_MCP_API_KEY_HEADER=API-Key

# Shape 2: OAuth2 client credentials. All three are required together; a
# partially-filled set is a misconfiguration and /health reports it as one.
# Any client the gateway trusts works — this does not require an Agent Identity.
HOTEL_MCP_TOKEN_URL=
HOTEL_MCP_CLIENT_ID=
HOTEL_MCP_CLIENT_SECRET=
# A request, not an entitlement: the authorisation server grants what it grants.
HOTEL_MCP_SCOPES=

# --- Behaviour --------------------------------------------------------------
# baseline | broken | broken-2
SYSTEM_PROMPT_VARIANT=baseline

# Legacy PMS date compatibility layer in mcp_client.py. Ships enabled.
HOTEL_MCP_LEGACY_DATE_COMPAT=true

# --- Tracing ----------------------------------------------------------------
# Nothing to set. Tracing comes from Agent Manager's auto-instrumentation, which
# the platform injects at deploy time. Keep that toggle ON. There is no local
# OTEL setup in this repository and none should be added.
