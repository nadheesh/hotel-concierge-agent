# hotel-mcp configuration
#
# This server has NO application-level security. It authenticates nobody and
# authorises nothing; every tool runs for any caller that reaches the endpoint.
# Authorisation is the gateway's job (the Agent Manager MCP Proxy in front of
# this server). See scopes.py for the read/write split to configure there.

PORT=9000

# Facilitator-only endpoints /admin/reset and /admin/audit. Leave unset to
# disable them entirely. These are destructive operator tooling, not part of
# the agent-facing surface.
HOTEL_MCP_ADMIN_TOKEN=
